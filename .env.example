# ========= 邮件通知配置（可选）=========
# 用法：把本文件复制/改名为  .env  （前面有个点，没有 .example）
# 然后填上你自己的邮箱信息。不配也能用，只是抢到活动时没有邮件提醒。
#
# QQ 邮箱授权码怎么拿：
#   网页版 QQ 邮箱 → 设置 → 账户 → 找到"IMAP/SMTP服务" → 开启 → 生成授权码（16位字母）
#   注意：授权码不是你的邮箱密码！
# 用其他邮箱（163/Gmail 等）就改 SERVER/PORT，并换成对应的授权码。

INFO_EMAIL_SERVER=smtp.qq.com
INFO_EMAIL_PORT=465
INFO_EMAIL_HOST=你的邮箱@qq.com
INFO_EMAIL_SMTP_PASS=你的16位授权码
